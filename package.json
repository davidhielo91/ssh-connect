{
  "name": "ssh-connect",
  "productName": "SSH Connect",
  "version": "1.0.0",
  "description": "Cliente SSH sencillo para Windows con conexión que nunca se cae",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "author": "davidhielo91",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.9.0": true
  },
  "build": {
    "appId": "com.sshconnect.app",
    "productName": "SSH Connect",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
